{
    "name": "edexcel/timetable",
    "description": "Edexcel College Timetable Management System",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5",
        "dompdf/dompdf": "^3.1",
        "lbuchs/webauthn": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Edexcel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Edexcel\\Tests\\": "tests/"
        }
    }, 
    "audit": {
        "block-insecure": true
    }
}
