# Staging environment template — placeholders only, no real secrets.
# Copy to a staging host as `.env` and fill in values locally.

APP_ENV=staging
APP_DEBUG=true
APP_URL=https://staging.example.com
BASE_URL=https://staging.example.com/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edexcel_staging
DB_USERNAME=staging_user
DB_PASSWORD=change_me

# Session / crypto
APP_KEY=base64:REPLACE_WITH_RANDOM_32_BYTE_KEY

# Payments (sandbox)
ONEPAY_APP_ID=
ONEPAY_MERCHANT_ID=
ONEPAY_HASH_SALT=
ONEPAY_SANDBOX=true

# WhatsApp Cloud API (test number)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=

# Media
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional AI
GROQ_API_KEY=
GEMINI_API_KEY=

# Google OAuth (students & parents only — never creates admin/teacher)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://staging.example.com/auth/google/callback.php

# Backups
BACKUP_ENABLED=true
BACKUP_LOCATION=storage/backups
