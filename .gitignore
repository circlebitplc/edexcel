# =========================================================
# Environment / secrets
# =========================================================
.env
.env.*
.env.local
.env.staging
.env.production
!.env.example
!.env.*.example

# Local configuration containing credentials
config/.env
config/*secret*
config/*secrets*
config/*credential*
config/*credentials*

# =========================================================
# Database dumps / backups
# =========================================================
*.sql
*.sql.gz
*.dump
*.bak
*.backup

# Whitelist schema migration files
!database/migrations/*.sql

# Project backup directories
backups/
backup/
storage/backups/*
!storage/backups/.htaccess
!storage/backups/index.html

# =========================================================
# Storage & Private User Data
# =========================================================
storage/logs/*
!storage/logs/.htaccess
!storage/logs/index.html

storage/imports/*
!storage/imports/index.html

storage/cache/*

uploads/*
!uploads/.gitkeep
files/documents/*
!files/documents/.htaccess
!files/documents/.gitkeep
files/homework/*
!files/homework/.gitkeep
!files/homework/.htaccess
files/payment_slips/*
!files/payment_slips/.htaccess
!files/payment_slips/.gitkeep

# =========================================================
# Logs
# =========================================================
*.log
logs/

# =========================================================
# Application Cache
# =========================================================
cache/*
!cache/.htaccess
!cache/.gitkeep
*.cache

# =========================================================
# Dependencies
# =========================================================
vendor/
node_modules/

# =========================================================
# SSH / SSL / Private Keys
# =========================================================
*.pem
*.key
*.pkcs12
*.pfx
*.ppk
id_rsa*
id_ed25519*
.ssh/

# =========================================================
# Archives & compressed backups
# =========================================================
*.rar
*.zip
*.7z
*.tar
*.tar.gz
*.tgz

# =========================================================
# Temporary files & Editor files
# =========================================================
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.cursor/

# =========================================================
# Testing & Composer auth
# =========================================================
.phpunit.result.cache
.phpunit.cache/
auth.json

# Let's Encrypt / ACME temporary files
.well-known/acme-challenge/*
