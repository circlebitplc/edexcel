# Copy to .env on the VPS. Do not put real secrets in git or on the college public_html site.

LIVEKIT_HOST=live.kandy.edexcel.college
S3_HOST=s3.live.kandy.edexcel.college

# Must match Admin → Settings → Live classroom (or the college .env LIVEKIT_API_KEY / SECRET).
# Generate with: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=REPLACE_API_KEY
LIVEKIT_API_SECRET=REPLACE_API_SECRET

# MinIO root user. Paste the same values into Admin → Live classroom S3 access key / secret.
MINIO_ROOT_USER=livekit
MINIO_ROOT_PASSWORD=change-this-to-a-long-random-password
